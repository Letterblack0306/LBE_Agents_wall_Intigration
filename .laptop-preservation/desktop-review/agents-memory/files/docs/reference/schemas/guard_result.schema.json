{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Guard Result",
  "type": "object",
  "required": [
    "result_id",
    "guard_id",
    "verdict",
    "evidence_refs",
    "executed_at"
  ],
  "properties": {
    "result_id": {
      "type": "string"
    },
    "guard_id": {
      "type": "string"
    },
    "guard_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "workspace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "INSUFFICIENT_EVIDENCE",
        "NOT_APPLICABLE"
      ]
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "governance_state": {
      "enum": [
        "READ_ONLY",
        "ALLOW",
        "DENY",
        "APPROVAL_REQUIRED",
        "INCOMPLETE"
      ]
    },
    "executed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
