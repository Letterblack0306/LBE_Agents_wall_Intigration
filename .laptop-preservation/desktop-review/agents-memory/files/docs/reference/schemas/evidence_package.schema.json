{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence Package",
  "type": "object",
  "required": [
    "package_id",
    "task_id",
    "indexed_evidence",
    "workspace_evidence",
    "validation_evidence",
    "gaps"
  ],
  "properties": {
    "package_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "indexed_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "workspace_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "validation_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": [
        "ref",
        "source_type",
        "authority",
        "verified"
      ],
      "properties": {
        "ref": {
          "type": "string"
        },
        "source_type": {
          "enum": [
            "index",
            "workspace",
            "validation",
            "policy",
            "proof"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "line_start": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "line_end": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "snippet": {
          "type": [
            "string",
            "null"
          ]
        },
        "authority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "verified": {
          "type": "boolean"
        },
        "classification": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
