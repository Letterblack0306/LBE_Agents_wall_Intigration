# Normalize text files to LF line endings for consistent encoding
*.md    text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.cjs   text eol=lf
*.ts    text eol=lf
*.d.ts  text eol=lf

# release-public/.npmignore is regenerated by the public SDK build on Windows.
# Keep its worktree line endings aligned with the generator so pack checks do not dirty clean release checkouts.
LBE_Core_Engine/release-public/.npmignore text eol=crlf

# Binary files - never modify
*.wasm  binary
*.png   binary
*.jpg   binary
*.svg   binary
