# LetterBlack Sentinel - Security-First .gitignore

# === CRITICAL SECRETS ===
# NEVER commit private keys
keys/secret.key
keys/*.key
keys/*.pem
*.key
*.pem

# Environment variables
.env
.env.*
!.env.example

# === RUNTIME DATA ===
# Nonce store contains sensitive replay protection data
data/nonce.db.json
data/*.db.json

# Policy state (runtime)
data/policy.state.json

# Audit logs may contain sensitive execution history
data/audit.log.jsonl
data/*.log
data/*.jsonl

# Temporary execution artifacts
data/tmp/
data/temp/
data/backups/

# === NODE ===
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn/

# === TESTING ===
test-proposal.json
test-*.json
*.test.json
coverage/
.nyc_output/

# === IDE ===
.vscode/*
.idea/
*.swp
*.swo
*~
.DS_Store

# === BUILD ===
dist/
build/
*.tsbuildinfo

# === LOGS ===
logs/
*.log

# === LBE RUNTIME ARTIFACTS ===
# Generated by npx lbe init — instance-specific, not source
lbe.workspace.json
lbe.audit.jsonl
.lbe/
# Pack artifacts
*.tgz
lbe-real-sdk-test/
deploy/
# Instance-specific crypto (regenerated per-install by npx lbe init)
config/keys.json
config/policy.sig.json

# Rust build artifacts
native/**/target/

# Local Claude agent workspace config
../.claude/.claude/

# Generated release artifacts — rebuilt during release, never edited manually
release-public/
release-exec/
npm-pack-check/
pack-result.json

# Local LBE policy state — instance-specific, never commit
lbe.policy.json
