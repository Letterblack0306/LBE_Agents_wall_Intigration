#!/bin/sh
# pre-commit: runs from git root (Z:\\Core_Control)
# Blocks commit from: non-main branch, linked worktree
# Also auto-regenerates governance indexes and checks version alignment
set -e

# Gate 1: Branch/worktree authority (always required)
node LBE_Core_Engine/scripts/mainhead-guard.mjs

# Gate 2: Auto-regenerate governance indexes (AGENT_INDEX.md, docs/00_INDEX.md)
cd LBE_Core_Engine
node scripts/governance.mjs index

# Gate 3: Verify version alignment across all surfaces
node scripts/version-sync.mjs --check

echo "[pre-commit] All gates passed"